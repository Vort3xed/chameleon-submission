# OS
.DS_Store

# Python
__pycache__/
*.pyc
.pytest_cache/

# Virtual environments
.venv/
venv/

# cr-renderer is a separate, external open-source project
# (https://github.com/CyberAgentAILab/cr-renderer), pulled in locally for
# reference/dev and installed by the engines via
# `pip install git+https://github.com/CyberAgentAILab/cr-renderer` — not
# vendored into this repo.
/cr-renderer/

# Generated run artifacts
output/*
!output/.gitkeep

# Generated evaluation artifacts (reproducible from eval/gen_testset.py seeds)
eval/testsets/
eval/runs/
eval/prefs/
eval/snapshots/
eval/gallery/
eval/judge_bench/
eval/labels/img/

# Express viewer build artifacts
viewer/node_modules/
viewer/dist/
viewer/*.zip

# Local submission reviews and generated review evidence
/docs/SUBMISSION_REVIEW*.md
/docs/adversarial-results*.json
/docs/retention-comparison.json
/docs/evidence/*.png
